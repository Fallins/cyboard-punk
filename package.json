{
  "name": "cyboard-punk",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "operator:inspect": "node scripts/inspect-operator-glb.mjs",
    "operator:verify:2d-master": "node scripts/verify-nyx-master.mjs",
    "operator:extract:2d": "node scripts/extract-nyx-2d-effects.mjs",
    "operator:build:2d": "node scripts/build-operator-2d.mjs",
    "operator:validate": "node scripts/validate-operator-assets.mjs",
    "operator:validate:strict": "node scripts/validate-operator-assets.mjs --strict",
    "operator:validate:legacy": "node scripts/validate-operator-assets.mjs",
    "operator:validate:legacy:strict": "node scripts/validate-operator-assets.mjs --strict",
    "operator:validate:2d": "node scripts/validate-operator-2d.mjs",
    "operator:validate:2d:strict": "node scripts/validate-operator-2d.mjs --strict",
    "operator:validate:face": "node scripts/validate-nyx-face-overlays.mjs",
    "operator:validate:release": "node scripts/validate-nyx-release.mjs",
    "operator:intake": "node scripts/intake-operator-asset.mjs",
    "operator:preview:2d": "node scripts/dev-nyx2d-preview.mjs",
    "operator:preview:gaze-off": "node scripts/dev-nyx2d-gaze-off.mjs",
    "prepare:icons": "tauri icon public/brand/cyboard-mark.svg --output src-tauri/generated-icons",
    "check": "bun run operator:verify:2d-master && bun run operator:validate:face && bun run operator:validate:release && bun run typecheck && bun run test && bun run build && bun run operator:validate:2d",
    "tauri": "bun run prepare:icons && tauri"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "solid-js": "^1.9.9",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "meshoptimizer": "^1.0.1",
    "prettier": "^3.8.4",
    "sharp": "^0.34.4",
    "typescript": "^6.0.3",
    "vite": "^7.1.3",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  }
}
